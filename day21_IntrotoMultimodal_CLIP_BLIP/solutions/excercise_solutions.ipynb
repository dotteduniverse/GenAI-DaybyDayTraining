    "# Solutions – Day 21 Exercises"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "from transformers import CLIPProcessor, CLIPModel, BlipProcessor, BlipForConditionalGeneration\n",
    "from PIL import Image\n",
    "import requests\n",
    "import numpy as np\n",
    "from pathlib import Path\n",
    "\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "clip_model = CLIPModel.from_pretrained(\"openai/clip-vit-base-patch32\").to(device)\n",
    "clip_processor = CLIPProcessor.from_pretrained(\"openai/clip-vit-base-patch32\")\n",
    "blip_processor = BlipProcessor.from_pretrained(\"Salesforce/blip-image-captioning-base\")\n",
    "blip_model = BlipForConditionalGeneration.from_pretrained(\"Salesforce/blip-image-captioning-base\").to(device)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Exercise 1: Different images"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "image_urls = [\n",
    "    (\"https://images.dog.ceo/breeds/hound-afghan/n02088094_1003.jpg\", \"dog\"),\n",
    "    (\"https://upload.wikimedia.org/wikipedia/commons/4/47/American_Eagle.jpg\", \"eagle\"),\n",
    "    (\"https://cdn.pixabay.com/photo/2015/04/23/22/00/tree-736885_1280.jpg\", \"landscape\")\n",
    "]\n",
    "labels = [\"a dog\", \"an eagle\", \"a tree\", \"a mountain\", \"a car\"]\n",
    "\n",
    "for url, name in image_urls:\n",
    "    img = Image.open(requests.get(url, stream=True).raw)\n",
    "    inputs = clip_processor(text=labels, images=img, return_tensors=\"pt\", padding=True).to(device)\n",
    "    with torch.no_grad():\n",
    "        probs = clip_model(**inputs).logits_per_image.softmax(dim=1).cpu().numpy()[0]\n",
    "    best_idx = probs.argmax()\n",
    "    print(f\"{name}: top label = '{labels[best_idx]}' (prob {probs[best_idx]:.3f})\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Exercise 2: Custom label set for cat image"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "cat_url = \"https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/cats.png\"\n",
    "cat_img = Image.open(requests.get(cat_url, stream=True).raw)\n",
    "specific_labels = [\"a kitten\", \"an adult cat\", \"a tiger\", \"a lion\"]\n",
    "inputs = clip_processor(text=specific_labels, images=cat_img, return_tensors=\"pt\", padding=True).to(device)\n",
    "with torch.no_grad():\n",
    "    probs = clip_model(**inputs).logits_per_image.softmax(dim=1).cpu().numpy()[0]\n",
    "for lbl, p in zip(specific_labels, probs):\n",
    "    print(f\"{lbl}: {p:.4f}\")\n",
    "print(\"\\nExplanation: CLIP picks 'a kitten' because the image shows a small cat.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Exercise 3: BLIP on challenging images"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "challenging_urls = [\n",
    "    \"https://images.pexels.com/photos/1430675/pexels-photo-1430675.jpeg\",  # street scene\n",
    "    \"https://upload.wikimedia.org/wikipedia/en/7/7d/Las_Meninas_by_Diego_Vel%C3%A1zquez.jpg\"  # abstract-ish painting\n",
    "]\n",
    "for url in challenging_urls:\n",
    "    img = Image.open(requests.get(url, stream=True).raw)\n",
    "    inputs = blip_processor(images=img, return_tensors=\"pt\").to(device)\n",
    "    out = blip_model.generate(**inputs, max_length=20)\n",
    "    caption = blip_processor.decode(out[0], skip_special_tokens=True)\n",
    "    print(f\"Caption: {caption}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Exercise 4: Cosine similarity between image and text embeddings"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch.nn.functional as F\n",
    "\n",
    "with torch.no_grad():\n",
    "    image_features = clip_model.get_image_features(pixel_values=inputs.pixel_values)\n",
    "    text_features = clip_model.get_text_features(input_ids=inputs.input_ids)\n",
    "    \n",
    "    image_features = F.normalize(image_features, p=2, dim=-1)\n",
    "    text_features = F.normalize(text_features, p=2, dim=-1)\n",
    "    \n",
    "    similarity = (image_features @ text_features.T).cpu().numpy()\n",
    "    print(\"Similarity matrix (rows: image, cols: text labels):\")\n",
    "    print(similarity)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Exercise 5: Multimodal retrieval (text → image)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Assume you have a folder 'test_images' with 5-10 images\n",
    "image_folder = Path(\"test_images\")\n",
    "image_paths = list(image_folder.glob(\"*.jpg\")) + list(image_folder.glob(\"*.png\"))\n",
    "\n",
    "image_embeds = []\n",
    "for path in image_paths:\n",
    "    img = Image.open(path).convert(\"RGB\")\n",
    "    inputs = clip_processor(images=img, return_tensors=\"pt\").to(device)\n",
    "    with torch.no_grad():\n",
    "        emb = clip_model.get_image_features(**inputs).cpu().numpy()\n",
    "        image_embeds.append(emb)\n",
    "\n",
    "query = \"a blue car\"\n",
    "text_inputs = clip_processor(text=[query], return_tensors=\"pt\", padding=True).to(device)\n",
    "with torch.no_grad():\n",
    "    text_embed = clip_model.get_text_features(**text_inputs).cpu().numpy()\n",
    "\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "sims = cosine_similarity(text_embed, np.vstack(image_embeds))[0]\n",
    "best_idx = sims.argmax()\n",
    "print(f\"Best match: {image_paths[best_idx].name} (similarity = {sims[best_idx]:.4f})\")"
   }
  ]
 ],
